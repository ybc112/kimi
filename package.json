{
  "name": "flap-vault-ai-coder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-spa-routes.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "test": "vitest run",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "templates:generate": "node scripts/generate-deploy-templates.mjs",
    "templates:check": "node scripts/generate-deploy-templates.mjs --check",
    "secrets:check": "node scripts/check-secrets.mjs",
    "kimimint:backend": "node server/kimimint-backend.mjs",
    "kimimint:verify:project": "node scripts/verify-kimimint-project.cjs",
    "nft:deploy:bsc": "node scripts/deploy-nft-factory-direct.cjs",
    "nft:deploy:direct": "node scripts/deploy-nft-factory-direct.cjs",
    "nft:verify": "node scripts/prepare-full-verify.mjs && node scripts/verify-kiminft.cjs",
    "verify": "npm run secrets:check && npm run check && npm run lint && npm run test && npm run contracts:compile && npm run templates:check && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "dotenv": "^16.4.7",
    "clsx": "^2.1.1",
    "ethers": "^6.17.0",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.3.0",
    "react-syntax-highlighter": "^15.5.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^5.0.2",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.6",
    "dotenv": "^16.4.7",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "hardhat": "^2.29.0",
    "postcss": "^8.5.3",
    "solc": "^0.8.36",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
